<% content_for :title, "Coordonnées de commande" %>
<% content_for :meta_description, "Complétez vos informations avant de procéder au paiement sécurisé de votre panier." %>
<% content_for :structured_data do %>
  <%= jsonld_tag(checkout_page_schema(title: page_title_value, description: page_meta_description)) %>
<% end %>

<div class="container py-4">
  <h1 class="text-center mb-4">Finaliser votre commande</h1>

  <% missing_attributes = current_user.missing_profile_fields %>

  <section class="checkout-profile-warning">
    <% if missing_attributes.any? %>
      <p>
        Il nous manque :
        <strong><%= missing_attributes.map { |field| User.human_attribute_name(field) }.join(", ") %></strong>.
        Merci de compléter vos informations avant de procéder au paiement.
      </p>
    <% else %>
      <p>Toutes vos informations sont complètes. Vous pouvez passer au paiement.</p>
    <% end %>
  </section>

  <section class="checkout-profile-form">
    <%= render partial: "users/profile_form",
              locals: { user: current_user, cart_context: true, redirect_path: cart_path(current_user.cart) } %>
  </section>

  <% if @cart_products.any? %>
    <section class="card shadow-sm border-0 mt-4">
      <div class="card-body">
        <h2 class="h5 mb-3">Récapitulatif avant paiement</h2>
        <p class="mb-1">Sous-total produits : <strong><%= number_to_currency(@cart_pricing.items_total, unit: "€") %></strong></p>
        <p class="mb-1">Poids total : <strong><%= format_weight(@cart_pricing.total_weight) %></strong></p>
        <p class="mb-1">Frais de port : <strong><%= number_to_currency(@cart_pricing.shipping_amount, unit: "€") %></strong></p>
        <p class="mb-0">Total à payer : <strong><%= number_to_currency(@cart_pricing.total_amount, unit: "€") %></strong></p>
      </div>
    </section>
  <% end %>

  <section class="checkout-actions">
    <%= link_to "Retour au panier", cart_path(current_user.cart), class: "btn btn-outline-secondary" %>
  </section>
</div>
