<% about_options = AboutPage.order(:section_type, :position, :title).map { |p|
     position_label = p.position.present? ? "##{p.position}" : "#-"
     ["#{p.section_label} - #{position_label} - #{p.title}", p.id]
   } %>
<% repair_options = RepairPage.order(:position, :title).map { |p| ["##{p.position} - #{p.title}", p.id] } %>
<style>
  .home-block-form [data-home-block-form-target="targetSection"],
  .home-block-form [data-home-block-form-target="shopSection"],
  .home-block-form [data-home-block-form-target="contentSection"],
  .home-block-form [data-home-block-form-target="splitOptionsSection"],
  .home-block-form [data-home-block-form-target="buttonSection"],
  .home-block-form [data-home-block-form-target="imageSection"] {
    display: none;
  }

  .home-block-form:has(select[name="home_page[bloc_type]"] option[value="custom"]:checked)
  [data-home-block-form-target="contentSection"],
  .home-block-form:has(select[name="home_page[bloc_type]"] option[value="custom"]:checked)
  [data-home-block-form-target="imageSection"] {
    display: block;
  }

  .home-block-form:has(select[name="home_page[bloc_type]"] option[value="custom"]:checked)
  [data-home-block-form-target="splitOptionsSection"] {
    display: flex;
  }

  .home-block-form:has(select[name="home_page[bloc_type]"] option[value="about"]:checked)
  [data-home-block-form-target="targetSection"],
  .home-block-form:has(select[name="home_page[bloc_type]"] option[value="about"]:checked)
  [data-home-block-form-target="buttonSection"],
  .home-block-form:has(select[name="home_page[bloc_type]"] option[value="repair"]:checked)
  [data-home-block-form-target="targetSection"],
  .home-block-form:has(select[name="home_page[bloc_type]"] option[value="repair"]:checked)
  [data-home-block-form-target="buttonSection"],
  .home-block-form:has(select[name="home_page[bloc_type]"] option[value="shop"]:checked)
  [data-home-block-form-target="shopSection"],
  .home-block-form:has(select[name="home_page[bloc_type]"] option[value="shop"]:checked)
  [data-home-block-form-target="buttonSection"] {
    display: block;
  }
</style>

<%= form_with(model: home_page, class: "home-block-form", data: { controller: "home-block-form" }) do |form| %>
  <% if home_page.errors.any? %>
    <div class="alert alert-danger">
      <h2 class="h6 mb-2"><%= pluralize(home_page.errors.count, "erreur") %> empêchent l’enregistrement :</h2>
      <ul class="mb-0">
        <% home_page.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, "Titre", class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :bloc_type, "Type de bloc", class: "form-label" %>
    <%= form.select :bloc_type,
                    [["Bloc personnalisé", "custom"],
                     ["Bloc À propos", "about"],
                     ["Bloc réparation", "repair"],
                     ["Bloc boutique", "shop"]],
                    {},
                    class: "form-select",
                    data: { "home-block-form-target": "blocType", action: "change->home-block-form#toggle" } %>
    <div class="form-text">
      Règles automatiques: “Image + texte” pour les blocs personnalisés, “Encadré titre + description” pour À propos/Réparation.
    </div>
  </div>

  <div class="mb-3" data-home-block-form-target="targetSection">
    <%= form.label :target_id, "Bloc cible (À propos / Réparation)", class: "form-label" %>
    <%= form.select :target_id,
                    [],
                    {},
                    class: "form-select",
                    data: {
                      "home-block-form-target": "targetSelect",
                      about_options: about_options.to_json,
                      repair_options: repair_options.to_json,
                      selected_value: home_page.target_id
                    } %>
    <div class="form-text">Utilisé uniquement si le type est “Bloc À propos” ou “Bloc réparation”.</div>
  </div>

  <div class="mb-3" data-home-block-form-target="shopSection">
    <%= form.label :shop_scope, "Sélection boutique", class: "form-label" %>
    <%= form.select :shop_scope,
                    [["Premiers produits", "first"],
                     ["Derniers produits", "last"],
                     ["Produits les plus achetés", "top_sellers"]],
                    {},
                    class: "form-select" %>
    <div class="form-text">Utilisé si le type est “Bloc boutique”.</div>
    <div class="mt-3">
      <%= form.label :shop_products_limit, "Nombre d’articles à afficher", class: "form-label" %>
      <%= form.number_field :shop_products_limit, class: "form-control", min: 1, step: 1 %>
      <div class="form-text">Minimum 1. L’affichage s’adapte automatiquement.</div>
    </div>
  </div>

  <div class="mb-3" data-home-block-form-target="contentSection">
    <%= form.label :content, "Contenu (bloc personnalisé)", class: "form-label" %>
    <%= form.text_area :content, class: "form-control", rows: 4 %>
    <div class="form-text">S’affiche uniquement pour les blocs personnalisés.</div>
  </div>

  <div class="row g-3 mb-3" data-home-block-form-target="splitOptionsSection">
    <div class="col-md-4">
      <%= form.label :layout_background, "Fond du bloc", class: "form-label" %>
      <%= form.select :layout_background,
                      [["Fond thème", "theme"],
                       ["Fond blanc", "white"]],
                      {},
                      class: "form-select" %>
    </div>
    <div class="col-md-4">
      <%= form.label :layout_text_tone, "Couleur du texte", class: "form-label" %>
      <%= form.select :layout_text_tone,
                      [["Texte thème", "theme"],
                       ["Texte clair", "light"]],
                      {},
                      class: "form-select" %>
    </div>
    <div class="col-md-4">
      <%= form.label :layout_image_position, "Position image", class: "form-label" %>
      <%= form.select :layout_image_position,
                      [["Image à gauche", "left"],
                       ["Image à droite", "right"]],
                      {},
                      class: "form-select" %>
    </div>
  </div>

  <div class="mb-3" data-home-block-form-target="buttonSection">
    <%= form.label :button_label, "Texte du bouton", class: "form-label" %>
    <%= form.text_field :button_label, class: "form-control", placeholder: "Ex : Découvrir" %>
    <div class="form-text">Disponible pour les blocs boutique, à propos et réparation.</div>
  </div>

  <div class="mb-3" data-home-block-form-target="imageSection">
    <%= form.label :image, "Image du bloc", class: "form-label" %>
    <%= form.file_field :image, class: "form-control" %>
    <div class="form-text">
      Image utilisée sur le design “Image + texte”. Le cadrage reste homogène automatiquement.
    </div>
    <% if home_page.image.attached? %>
      <div class="mt-2">
        <%= attachment_thumb(home_page.image, variant_options: { resize_to_limit: [200, 200] }, class: "img-thumbnail") %>
      </div>
    <% end %>
  </div>

  <% if home_page.persisted? %>
    <div class="mb-3">
      <%= form.label :position, "Position", class: "form-label" %>
      <%= form.number_field :position, class: "form-control" %>
    </div>
  <% end %>

  <div class="d-flex gap-2">
    <%= form.submit "Enregistrer", class: "btn btn-primary" %>
  </div>
<% end %>
