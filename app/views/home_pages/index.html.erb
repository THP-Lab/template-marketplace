<% content_for :title, "Accueil" %>
<%
  meta_source = @home_pages.map { |home_page| home_page.resolved_content.to_s }.join(" ")
%>
<% content_for :meta_description,
                meta_description_from(meta_source) ||
                "Découvrir l'atelier, nos créations sur mesure et les engagements qualité de Template Marketplace." %>
<% content_for :structured_data do %>
  <% sections = @home_pages.map { |home_page|
    {
      "@type": "CreativeWork",
      "name": home_page.resolved_title,
      "description": meta_description_from(home_page.resolved_content.to_s)
    }.compact_blank
  }.compact_blank %>
  <%= jsonld_tag(webpage_schema(name: page_title_value,
                                description: page_meta_description,
                                has_part: sections.presence)) %>
<% end %>

<%
  company_information = @company_information || CompanyInformation.instance
  hero_background_url =
    if company_information.home_banner_image.attached?
      if company_information.home_banner_image.variable?
        url_for(company_information.home_banner_image.variant(resize_to_limit: [1600, 900]))
      else
        url_for(company_information.home_banner_image)
      end
    end
  hero_background_style =
    if hero_background_url.present?
      "background-image: url('#{hero_background_url}');"
    end
%>
<%= content_tag :header, class: "hero d-flex align-items-center text-center", style: hero_background_style do %>
  <div class="container">
    <h1 class="mt-4"><%= company_information.home_banner_title_or_default %></h1>
    <h4 class="mt-2"><%= company_information.home_banner_subtitle_or_default %></h4>
    <div class="mt-4">
      <%= link_to company_information.home_banner_primary_cta_label_or_default, about_pages_path, class: "btn btn-primary" %>
      <%= link_to company_information.home_banner_secondary_cta_label_or_default, products_path, class:"btn btn-primary" %>
    </div>
  </div>
<% end %>

<div class="product-section">
  <div class="container-fluid px-4">
    <div class="row text-center g-4 pt-4">
      <% company_information.home_highlights.each do |highlight| %>
        <div class="col-12 col-md-6 col-lg-3">
          <h4><%= highlight[:title] %></h4>
          <p><%= highlight[:description] %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="home-blocks">
  <% @home_pages.each do |home_page| %>
    <% section_classes =
         if home_page.shop_bloc_type?
           "mb-5 pb-4"
         elsif home_page.split_layout_variant?
           "home-blocks__section home-blocks__section--split"
         else
           "home-blocks__section mb-5 pb-4"
         end %>
    <section class="<%= section_classes %>">
      <% if home_page.shop_bloc_type? %>
        <div class="container">
          <h2 class="text-center mb-4"><%= home_page.title %></h2>
          <% products = home_page.shop_products.to_a %>
          <% if products.any? %>
            <section class="home-shop-swiper swiper"
                     data-controller="shop-swiper"
                     data-action="mouseenter->shop-swiper#pause mouseleave->shop-swiper#resume wheel->shop-swiper#wheel">
              <div class="home-shop-swiper__parallax parallax-bg"
                   data-swiper-parallax="600"
                   data-swiper-parallax-scale="0.88"></div>

              <div class="swiper-wrapper" data-shop-swiper-target="wrapper">
                <% products.each do |product| %>
                  <figure class="swiper-slide"
                          data-shop-swiper-target="slide"
                          data-action="click->shop-swiper#advanceFromClick">
                    <div class="cardPopout home-shop-swiper__card"
                         data-swiper-parallax="30"
                         data-swiper-parallax-scale="0.94"
                         data-swiper-parallax-opacity="0.85"
                         data-swiper-parallax-duration="900">
                      <%= render "home_pages/shop_product_card", product: product %>
                    </div>
                  </figure>
                <% end %>
              </div>

              <div class="swiper-scrollbar" data-shop-swiper-target="scrollbar"></div>
            </section>
            <div class="text-center mt-3">
              <% button_label = home_page.button_label.presence || "Accéder à la boutique" %>
              <%= link_to button_label, products_path, class: "btn btn-primary" %>
            </div>
          <% else %>
            <p class="text-muted">Aucun produit disponible pour ce bloc.</p>
          <% end %>
        </div>
      <% else %>
        <%= render "home_pages/content_block", home_page: home_page %>
      <% end %>
    </section>
  <% end %>
</div>
