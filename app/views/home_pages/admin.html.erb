<% content_for :title, "Admin - Accueil" %>

<div class="container py-4" data-controller="quantity-modal">
  <div class="row g-4">
    <div class="col-lg-4 col-xl-3">
      <%= render_admin_sidebar %>
    </div>
    <div class="col-lg-8 col-xl-9">
      <h1 class="mb-4">Blocs d’accueil (administration)</h1>

      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>

      <% if @home_pages.any? %>
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle"
                 data-controller="reorder"
                 data-reorder-url-value="<%= reorder_home_pages_path %>">
            <thead>
              <tr>
                <th>Titre</th>
                <th>Image</th>
                <th>Type</th>
                <th>Design</th>
                <th>Source / portée</th>
                <th>Contenu</th>
                <th class="text-end">Actions</th>
                <th class="text-end" style="width: 40px;"></th>
              </tr>
            </thead>
            <tbody>
              <% @home_pages.each do |home_page| %>
                <% target_label =
                     case home_page.bloc_type
                     when "about"
                       if (about_block = AboutPage.find_by(id: home_page.target_id))
                         "#{about_block.section_label} - #{about_block.title}"
                       else
                         "Bloc À propos ##{home_page.target_id}"
                       end
                     when "repair" then "Bloc Réparation ##{home_page.target_id}"
                     when "shop"
                       product_limit = [home_page.shop_products_limit.to_i, 1].max
                       case home_page.shop_scope
                       when "first" then "Boutique - #{product_limit} premiers"
                       when "last" then "Boutique - #{product_limit} derniers"
                       else "Boutique - #{product_limit} plus achetés"
                       end
                     else
                       "Bloc personnalisé"
                     end
                %>
                <tr id="<%= dom_id(home_page) %>"
                    data-reorder-target="item"
                    data-id="<%= home_page.id %>">
                  <td><%= home_page.title %></td>
                  <td>
                    <%= attachment_thumb(home_page.image, variant_options: { resize_to_limit: [80, 80] }, class: "img-thumbnail") || content_tag(:span, "—", class: "text-muted") %>
                  </td>
                  <td><%= home_page.bloc_type %></td>
                  <td>
                    <% if home_page.shop_bloc_type? %>
                      <span class="text-muted">Boutique (inchangé)</span>
                    <% elsif home_page.custom_bloc_type? %>
                      Image + texte
                      <small class="d-block text-muted">
                        <%= home_page.layout_background %> · <%= home_page.layout_text_tone %> · image <%= home_page.layout_image_position %>
                      </small>
                    <% else %>
                      Encadré titre + description
                    <% end %>
                  </td>
                  <td><%= target_label %></td>
                  <td><%= truncate(home_page.content.to_s, length: 100) %></td>
                  <td class="text-end">
                    <div class="d-flex justify-content-end gap-1">
                      <%= link_to "Modifier", edit_home_page_path(home_page), class: "btn btn-primary" %>
                      <%= form_with(url: home_page_path(home_page), method: :delete, class: "d-inline-flex m-0") do %>
                        <%= button_tag "Supprimer",
                                       type: "submit",
                                       class: "btn btn-danger btn-sm",
                                       data: {
                                         action: "click->quantity-modal#open",
                                         modal_title: "Supprimer le bloc",
                                         modal_message: "Cette action est définitive. Voulez-vous vraiment supprimer ce bloc d’accueil ?",
                                         modal_confirm_label: "Supprimer"
                                       } %>
                      <% end %>
                    </div>
                  </td>
                  <td class="text-end text-muted" style="width: 40px;">
                    <span class="reorder-handle" title="Déplacer">&#8942;</span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted">Aucun bloc d’accueil.</p>
      <% end %>

      <div class="d-flex justify-content-end gap-2 mt-3">
        <%= link_to "Configurer la bannière", home_banner_company_information_path, class: "btn btn-outline-secondary" %>
        <%= link_to "Ajouter une section", new_home_page_path, class: "btn btn-success" %>
      </div>
      <%= admin_pagination(@pagination) %>
      <%= render "shared/confirm_modal" %>
    </div>
  </div>
</div>
