<% content_for :title, "Admin - Onglets" %>

<%= admin_page(title: "Titres des onglets") do %>
  <div class="d-flex justify-content-end mb-3">
    <%= link_to "Infos entreprise", admin_company_information_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "Streaming Twitch", streaming_company_information_path, class: "btn btn-outline-secondary btn-sm ms-2" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <p class="text-muted small mb-4">
        Ces contenus pilotent les titres et sous-titres des pages publiques.
      </p>

      <%= form_with model: @company_information,
                    url: update_tabs_company_information_path,
                    method: :patch,
                    local: true do |f| %>
        <div class="row g-3">
          <div class="col-12">
            <h2 class="h6 mb-2">Boutique</h2>
          </div>
          <div class="col-12 col-md-6">
            <%= f.label :shop_page_title, "Titre", class: "form-label" %>
            <%= f.text_field :shop_page_title, class: "form-control", placeholder: CompanyInformation::DEFAULT_SHOP_PAGE_TITLE %>
          </div>
          <div class="col-12 col-md-6">
            <%= f.label :shop_page_subtitle, "Sous-titre", class: "form-label" %>
            <%= f.text_field :shop_page_subtitle, class: "form-control", placeholder: CompanyInformation::DEFAULT_SHOP_PAGE_SUBTITLE %>
          </div>

          <div class="col-12 mt-3">
            <h2 class="h6 mb-2">Événements</h2>
          </div>
          <div class="col-12 col-md-6">
            <%= f.label :events_page_title, "Titre", class: "form-label" %>
            <%= f.text_field :events_page_title, class: "form-control", placeholder: CompanyInformation::DEFAULT_EVENTS_PAGE_TITLE %>
          </div>
          <div class="col-12 col-md-6">
            <%= f.label :events_page_subtitle, "Sous-titre", class: "form-label" %>
            <%= f.text_field :events_page_subtitle, class: "form-control", placeholder: CompanyInformation::DEFAULT_EVENTS_PAGE_SUBTITLE %>
          </div>

          <div class="col-12 mt-3">
            <h2 class="h6 mb-2">Réparation</h2>
          </div>
          <div class="col-12 col-md-6">
            <%= f.label :repair_page_title, "Titre", class: "form-label" %>
            <%= f.text_field :repair_page_title, class: "form-control", placeholder: CompanyInformation::DEFAULT_REPAIR_PAGE_TITLE %>
          </div>
          <div class="col-12 col-md-6">
            <%= f.label :repair_page_subtitle, "Sous-titre", class: "form-label" %>
            <%= f.text_field :repair_page_subtitle, class: "form-control", placeholder: CompanyInformation::DEFAULT_REPAIR_PAGE_SUBTITLE %>
          </div>

          <div class="col-12 mt-3">
            <h2 class="h6 mb-2">Contact</h2>
          </div>
          <div class="col-12 col-md-6">
            <%= f.label :contact_page_title, "Titre", class: "form-label" %>
            <%= f.text_field :contact_page_title, class: "form-control", placeholder: CompanyInformation::DEFAULT_CONTACT_PAGE_TITLE %>
          </div>
          <div class="col-12 col-md-6">
            <%= f.label :contact_page_subtitle, "Sous-titre", class: "form-label" %>
            <%= f.text_field :contact_page_subtitle, class: "form-control", placeholder: CompanyInformation::DEFAULT_CONTACT_PAGE_SUBTITLE %>
          </div>
        </div>

        <div class="mt-4 d-flex justify-content-end">
          <%= f.submit "Enregistrer", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
