<% content_for :title, "Admin - TVA" %>

<%= admin_page(title: "TVA") do %>
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div class="d-flex gap-2">
      <%= link_to "Infos entreprise", admin_company_information_path, class: "btn btn-outline-secondary btn-sm" %>
      <%= link_to "Frais de port", shipping_company_information_path, class: "btn btn-outline-secondary btn-sm" %>
    </div>
  </div>

  <% if notice.present? %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>
  <% if alert.present? %>
    <div class="alert alert-danger"><%= alert %></div>
  <% end %>
  <% if @company_information.errors.any? %>
    <div class="alert alert-danger">
      <h2 class="h6 mb-2"><%= pluralize(@company_information.errors.count, "erreur") %> empêchent l’enregistrement :</h2>
      <ul class="mb-0">
        <% @company_information.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card shadow-sm">
    <div class="card-body">
      <p class="text-muted small mb-4">
        Configurez ici le taux de TVA appliqué au panier et le numéro de TVA affiché sur les factures. Le taux par défaut est à 0%.
      </p>

      <%= form_with model: @company_information,
                    url: update_vat_company_information_path,
                    method: :patch,
                    local: true do |f| %>
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <%= f.label :vat_rate, "Taux de TVA (%)", class: "form-label" %>
            <%= f.number_field :vat_rate, class: "form-control", min: 0, step: 0.01 %>
          </div>

          <div class="col-12 col-md-6">
            <%= f.label :vat_number, "Numéro de TVA", class: "form-label" %>
            <%= f.text_field :vat_number, class: "form-control", placeholder: "FRXX123456789" %>
          </div>
        </div>

        <div class="mt-4 d-flex justify-content-end">
          <%= f.submit "Enregistrer", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
