<% content_for :title, "Admin - Footer" %>

<div class="container py-4">
  <div class="row g-4">
    <div class="col-lg-4 col-xl-3">
      <%= render_admin_sidebar %>
    </div>
    <div class="col-lg-8 col-xl-9">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h1 class="mb-0">Description du footer</h1>
        <div class="d-flex gap-2">
          <%= link_to "Infos entreprise", admin_company_information_path, class: "btn btn-outline-secondary btn-sm" %>
          <%= link_to "TVA", vat_company_information_path, class: "btn btn-outline-secondary btn-sm" %>
        </div>
      </div>

      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>

      <div class="card shadow-sm">
        <div class="card-body">
          <p class="text-muted small mb-4">
            Ce texte apparaît dans le footer du site. Si vous laissez vide, le texte par défaut codé en dur est conservé.
          </p>

          <%= form_with model: @company_information,
                        url: update_footer_company_information_path,
                        method: :patch,
                        local: true do |f| %>
            <div class="mb-3">
              <%= f.label :footer_description, "Description", class: "form-label" %>
              <%= f.text_area :footer_description,
                              class: "form-control",
                              rows: 4,
                              placeholder: CompanyInformation::DEFAULT_FOOTER_DESCRIPTION %>
            </div>

            <div class="mt-4 d-flex justify-content-end">
              <%= f.submit "Enregistrer", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
