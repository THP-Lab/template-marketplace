<div class="shipping-rate-row border rounded p-3 mb-2" data-shipping-rates-form-item>
  <%= form.hidden_field :id if form.object.persisted? %>
  <%= form.hidden_field :_destroy,
                        value: (form.object.marked_for_destruction? ? "1" : "0"),
                        data: { role: "shipping-rate-destroy" } %>

  <div class="row g-2 align-items-end">
    <div class="col-12 col-md-5">
      <%= form.label :max_weight, "Poids total max (kg)", class: "form-label" %>
      <%= form.number_field :max_weight, class: "form-control", min: 0.001, step: 0.001 %>
    </div>

    <div class="col-12 col-md-5">
      <%= form.label :price, "Prix du port (€)", class: "form-label" %>
      <%= form.number_field :price, class: "form-control", min: 0, step: 0.01 %>
    </div>

    <div class="col-12 col-md-2 d-grid">
      <button type="button"
              class="btn btn-outline-danger btn-sm"
              data-action="shipping-rates-form#removeRate">
        Supprimer
      </button>
    </div>
  </div>
</div>
