<% content_for :title, "Admin - Bannière accueil" %>

<div class="container py-4">
  <div class="row g-4">
    <div class="col-lg-4 col-xl-3">
      <%= render_admin_sidebar %>
    </div>
    <div class="col-lg-8 col-xl-9">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h1 class="mb-0">Bannière de la page d’accueil</h1>
        <%= link_to "Retour aux blocs d’accueil", admin_home_pages_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>

      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>

      <div class="card shadow-sm">
        <div class="card-body">
          <p class="text-muted small mb-4">
            Cette configuration est liée uniquement à la bannière de la page d’accueil.
            Si un champ est vide, le texte actuellement codé en dur sera conservé automatiquement.
          </p>

          <%= form_with model: @company_information,
                        url: update_home_banner_company_information_path,
                        method: :patch,
                        local: true do |f| %>
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <%= f.label :home_banner_title, "Titre principal", class: "form-label" %>
                <%= f.text_field :home_banner_title, class: "form-control", placeholder: CompanyInformation::DEFAULT_HOME_BANNER_TITLE %>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :home_banner_subtitle, "Sous-titre", class: "form-label" %>
                <%= f.text_field :home_banner_subtitle, class: "form-control", placeholder: CompanyInformation::DEFAULT_HOME_BANNER_SUBTITLE %>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :home_banner_primary_cta_label, "Texte bouton à propos", class: "form-label" %>
                <%= f.text_field :home_banner_primary_cta_label, class: "form-control", placeholder: CompanyInformation::DEFAULT_HOME_BANNER_PRIMARY_CTA_LABEL %>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :home_banner_secondary_cta_label, "Texte bouton boutique", class: "form-label" %>
                <%= f.text_field :home_banner_secondary_cta_label, class: "form-control", placeholder: CompanyInformation::DEFAULT_HOME_BANNER_SECONDARY_CTA_LABEL %>
              </div>

              <div class="col-12">
                <%= f.label :home_banner_image, "Image de fond de la bannière", class: "form-label" %>
                <%= f.file_field :home_banner_image, class: "form-control", accept: "image/*" %>
                <div class="form-text">
                  Même format d’affichage que la bannière actuelle (cadrage cover). Laissez vide pour garder l’image par défaut.
                </div>
                <% if @company_information.home_banner_image.attached? %>
                  <div class="mt-2">
                    <%= attachment_thumb(@company_information.home_banner_image, variant_options: { resize_to_limit: [320, 180] }, class: "img-thumbnail") %>
                  </div>
                  <div class="form-check mt-2">
                    <%= check_box_tag "company_information[remove_home_banner_image]", "1", false, class: "form-check-input", id: "remove_home_banner_image" %>
                    <%= label_tag "remove_home_banner_image", "Supprimer l’image personnalisée (revenir à l’image par défaut)", class: "form-check-label" %>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="mt-4 d-flex justify-content-end">
              <%= f.submit "Enregistrer", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
