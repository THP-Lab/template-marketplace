<% content_for :title, "Admin - Informations légales" %>

<div class="container py-4">
  <div class="row g-4">
    <div class="col-lg-4 col-xl-3">
      <%= render_admin_sidebar %>
    </div>
    <div class="col-lg-8 col-xl-9">
      <h1 class="mb-4">Informations entreprise et accueil</h1>

      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>

      <div class="card shadow-sm">
        <div class="card-body">
          <p class="text-muted small mb-4">
            Ces informations servent a la facturation PDF et a la banniere de la page d’accueil.
          </p>
          <%= form_with model: @company_information,
                        url: company_information_path,
                        method: :patch,
                        local: true do |f| %>
            <div class="row g-3">
              <div class="col-12">
                <h2 class="h5 mb-1">Banniere de la page d’accueil</h2>
                <p class="text-muted small mb-0">
                  Si un champ est vide, le texte actuellement code en dur sera conserve automatiquement.
                </p>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :home_banner_title, "Titre principal", class: "form-label" %>
                <%= f.text_field :home_banner_title, class: "form-control", placeholder: CompanyInformation::DEFAULT_HOME_BANNER_TITLE %>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :home_banner_subtitle, "Sous-titre", class: "form-label" %>
                <%= f.text_field :home_banner_subtitle, class: "form-control", placeholder: CompanyInformation::DEFAULT_HOME_BANNER_SUBTITLE %>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :home_banner_primary_cta_label, "Texte bouton à propos", class: "form-label" %>
                <%= f.text_field :home_banner_primary_cta_label, class: "form-control", placeholder: CompanyInformation::DEFAULT_HOME_BANNER_PRIMARY_CTA_LABEL %>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :home_banner_secondary_cta_label, "Texte bouton boutique", class: "form-label" %>
                <%= f.text_field :home_banner_secondary_cta_label, class: "form-control", placeholder: CompanyInformation::DEFAULT_HOME_BANNER_SECONDARY_CTA_LABEL %>
              </div>

              <div class="col-12">
                <%= f.label :home_banner_image, "Image de fond de la banniere", class: "form-label" %>
                <%= f.file_field :home_banner_image, class: "form-control", accept: "image/*" %>
                <div class="form-text">
                  Meme format d’affichage que la banniere actuelle (cadrage cover). Laissez vide pour garder l’image par defaut.
                </div>
                <% if @company_information.home_banner_image.attached? %>
                  <div class="mt-2">
                    <%= attachment_thumb(@company_information.home_banner_image, variant_options: { resize_to_limit: [320, 180] }, class: "img-thumbnail") %>
                  </div>
                  <div class="form-check mt-2">
                    <%= check_box_tag "company_information[remove_home_banner_image]", "1", false, class: "form-check-input", id: "remove_home_banner_image" %>
                    <%= label_tag "remove_home_banner_image", "Supprimer l’image personnalisee (revenir a l’image par defaut)", class: "form-check-label" %>
                  </div>
                <% end %>
              </div>

              <div class="col-12">
                <hr>
                <h2 class="h5 mb-1">Informations de facturation</h2>
              </div>

              <div class="col-12">
                <%= f.label :legal_name, "Dénomination sociale", class: "form-label" %>
                <%= f.text_field :legal_name, class: "form-control" %>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :address_line1, "Adresse (ligne 1)", class: "form-label" %>
                <%= f.text_field :address_line1, class: "form-control" %>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :address_line2, "Adresse (ligne 2)", class: "form-label" %>
                <%= f.text_field :address_line2, class: "form-control" %>
              </div>

              <div class="col-6 col-md-3">
                <%= f.label :zipcode, "Code postal", class: "form-label" %>
                <%= f.text_field :zipcode, class: "form-control" %>
              </div>
              <div class="col-6 col-md-3">
                <%= f.label :city, "Ville", class: "form-label" %>
                <%= f.text_field :city, class: "form-control" %>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :country, "Pays", class: "form-label" %>
                <%= f.text_field :country, class: "form-control" %>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :siret, "SIRET / SIREN", class: "form-label" %>
                <%= f.text_field :siret, class: "form-control" %>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :vat_number, "Numéro de TVA", class: "form-label" %>
                <%= f.text_field :vat_number, class: "form-control" %>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :phone, "Téléphone", class: "form-label" %>
                <%= f.text_field :phone, class: "form-control" %>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :email, "Email de contact", class: "form-label" %>
                <%= f.email_field :email, class: "form-control" %>
              </div>

              <div class="col-12">
                <%= f.label :additional_info, "Informations complémentaires (mentions légales, conditions de paiement, etc.)", class: "form-label" %>
                <%= f.text_area :additional_info, class: "form-control", rows: 3 %>
              </div>
            </div>

            <div class="mt-4 d-flex justify-content-end">
              <%= f.submit "Enregistrer", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
