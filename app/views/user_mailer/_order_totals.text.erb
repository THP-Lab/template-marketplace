<% tax_rate_label = number_with_precision(@order.tax_rate_value, precision: 2, strip_insignificant_zeros: true) %>
Sous-total produits HT : <%= number_to_currency(@order.items_amount_value, unit: "€") %>
Frais de port HT : <%= number_to_currency(@order.shipping_amount_value, unit: "€") %>
TVA (<%= tax_rate_label %>%) : <%= number_to_currency(@order.tax_amount_value, unit: "€") %>
Total TTC : <%= number_to_currency(@order.total_amount_value, unit: "€") %>
