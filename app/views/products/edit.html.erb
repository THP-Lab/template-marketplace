<% content_for :title, "Admin - Modifier un produit" %>

<%= admin_page(title: "Modifier un produit") do %>
  <div data-controller="quantity-modal">
    <%= render "form", product: @product, redirect_to: edit_product_path(@product) %>

    <div class="mt-3 d-flex gap-2">
      <%= link_to "Voir le produit", @product, class: "btn btn-outline-secondary btn-sm" %>
      <%= link_to "Retour aux produits", admin_products_path, class: "btn btn-outline-secondary btn-sm" %>
      <%= form_with url: product_path(@product), method: :delete, class: "d-inline" do %>
        <%= hidden_field_tag :redirect_to, admin_products_path %>
        <%= button_tag "Supprimer",
                       type: "submit",
                       class: "btn btn-danger btn-sm",
                       data: {
                         action: "click->quantity-modal#open",
                         modal_title: "Supprimer le produit",
                         modal_message: "Cette action est définitive. Voulez-vous vraiment supprimer ce produit ?",
                         modal_confirm_label: "Supprimer"
                       } %>
      <% end %>
    </div>

    <%= render "shared/confirm_modal" %>
  </div>
<% end %>
