<% content_for :title, "Admin - Nouveau produit" %>

<%= admin_page(title: "Nouveau produit") do %>
  <%= render "form",
             product: @product,
             redirect_to: new_product_path,
             available_company_documents: @available_company_documents %>

  <div class="mt-3">
    <%= link_to "Retour aux produits", admin_products_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
<% end %>
