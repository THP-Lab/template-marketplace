<div id="<%= dom_id product %>">
  <% if product.image.attached? %>
    <div class="card-img p-0">
      <%= attachment_thumb(product.image,
                          variant_options: { resize_to_limit: [700, 520] },
                          alt: product.title) %>
    </div>
  <% end %>

  <div class="p-2">
    <div class="gold">
      <p><strong><%= product.category %></strong></p>
    </div>

    <div>
      <h5><%= product.title %></h5>
    </div>

    <div>
      <p><%= product.description %></p>
    </div>

    <div>
      <h5 class="gold"><%= number_to_currency(product.price, unit: "€", format: "%n %u") %></h5>
    </div>

    <!-- <div>
      <strong>Stock:</strong>
      <%= product.stock %>
    </div> -->

  </div>
 
</div>
