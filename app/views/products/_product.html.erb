<div id="<%= dom_id product %>">
  <% if product.primary_image.present? %>
    <div class="card-img p-0">
      <%= attachment_thumb(product.primary_image,
                          variant_options: { resize_to_fill: [700, 700] },
                          alt: product.title,
                          class: "w-100",
                          style: "aspect-ratio: 1 / 1; object-fit: cover;") %>
    </div>
  <% end %>

  <div class="p-2">
    <div class="gold">
      <p><strong><%= product.category %></strong></p>
    </div>

    <div>
      <h5><%= product.title %></h5>
    </div>

    <div>
      <p><%= product.description %></p>
    </div>

    <div>
      <h5 class="gold"><%= number_to_currency(product.price, unit: "€", format: "%n %u") %></h5>
    </div>

    <!-- <div>
      <strong>Stock:</strong>
      <%= product.stock %>
    </div> -->

  </div>
 
</div>
