<%= form_with(model: product) do |form| %>
  <% available_company_documents = local_assigns[:available_company_documents] || @available_company_documents || [] %>

  <% if local_assigns[:redirect_to].present? %>
    <%= hidden_field_tag :redirect_to, local_assigns[:redirect_to] %>
  <% end %>

  <% if product.errors.any? %>
    <div class="alert alert-danger">
      <h2 class="h6 mb-2"><%= pluralize(product.errors.count, "erreur") %> empêchent l’enregistrement :</h2>
      <ul class="mb-0">
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, "Titre", class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 4 %>
  </div>

  <div class="mb-3">
    <%= form.label :category, "Catégorie", class: "form-label" %>
    <%= form.text_field :category, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :price, "Prix", class: "form-label" %>
    <%= form.number_field :price, class: "form-control", step: 0.01 %>
  </div>

  <div class="mb-3">
    <%= form.label :stock, "Stock", class: "form-label" %>
    <%= form.number_field :stock, class: "form-control", min: 0 %>
  </div>

  <div class="card p-3 mb-3" data-controller="product-highlights-form">
    <div class="form-check">
      <%= form.check_box :show_product_highlights,
                         class: "form-check-input",
                         data: {
                           "product-highlights-form-target": "toggle",
                           action: "change->product-highlights-form#update"
                         } %>
      <%= form.label :show_product_highlights,
                     "Afficher des encarts d'informations sous le produit",
                     class: "form-check-label" %>
    </div>

    <div class="mt-3 <%= "d-none" unless product.show_product_highlights? %>" data-product-highlights-form-target="fields">
      <h3 class="h6 mb-3">Contenu des encarts</h3>
      <% Product::HIGHLIGHT_DEFAULTS.each_with_index do |defaults, index| %>
        <% number = index + 1 %>
        <div class="product-highlight-config border rounded p-3 mb-3">
          <div class="form-check mb-2">
            <%= form.check_box :"highlight_#{number}_enabled",
                               class: "form-check-input",
                               data: {
                                 index: index,
                                 "product-highlights-form-target": "itemToggle",
                                 action: "change->product-highlights-form#updateItem"
                               } %>
            <%= form.label :"highlight_#{number}_enabled", "Activer l'encart #{number}", class: "form-check-label fw-semibold" %>
          </div>

          <% panel_open = product.show_product_highlights? && product.public_send("highlight_#{number}_enabled") %>
          <div class="<%= "product-highlight-config__panel mt-2 #{'is-open' if panel_open} #{'d-none' unless panel_open}" %>"
               data-product-highlights-form-target="itemPanel">
            <div class="mb-2">
              <%= form.label :"highlight_#{number}_title", "Titre encart #{number}", class: "form-label" %>
              <%= form.text_field :"highlight_#{number}_title",
                                  class: "form-control",
                                  placeholder: defaults[:title] %>
            </div>
            <div>
              <%= form.label :"highlight_#{number}_description", "Description encart #{number}", class: "form-label" %>
              <%= form.text_area :"highlight_#{number}_description",
                                 class: "form-control",
                                 rows: 2,
                                 placeholder: defaults[:description] %>
            </div>

            <div class="form-check mt-3">
              <%= form.check_box :"highlight_#{number}_document_enabled",
                                 class: "form-check-input",
                                 data: {
                                   index: index,
                                   "product-highlights-form-target": "documentToggle",
                                   action: "change->product-highlights-form#updateDocumentSelection"
                                 } %>
              <%= form.label :"highlight_#{number}_document_enabled",
                             "Intégrer un document",
                             class: "form-check-label fw-semibold" %>
            </div>

            <% include_document = product.public_send("highlight_#{number}_document_enabled") %>
            <% can_select_document = panel_open && include_document %>
            <div class="mt-2 <%= "d-none" unless include_document %>" data-product-highlights-form-target="documentSelectGroup">
              <% if available_company_documents.any? %>
                <%= form.label :"highlight_#{number}_company_document_id", "Document PDF", class: "form-label" %>
                <%= form.select :"highlight_#{number}_company_document_id",
                                options_from_collection_for_select(available_company_documents, :id, :title, product.public_send("highlight_#{number}_company_document_id")),
                                { include_blank: "Sélectionner un document" },
                                class: "form-select",
                                data: { "product-highlights-form-target": "documentSelect" },
                                disabled: !can_select_document %>
              <% else %>
                <p class="small text-muted mb-0">
                  Aucun document disponible. Ajoutez-en dans Information > Documents.
                </p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :images, "Photos du produit", class: "form-label" %>
    <%= form.file_field :images, multiple: true, accept: "image/*", class: "form-control" %>
    <small class="text-muted d-block mt-1">Vous pouvez sélectionner plusieurs photos. Affichage recadré en carré.</small>

    <% if product.gallery_images.any? %>
      <div class="row g-2 mt-2">
        <% product.gallery_images.each do |gallery_image| %>
          <% checkbox_id = dom_id(gallery_image, :remove) %>
          <div class="col-4 col-md-3 col-lg-2">
            <div class="gallery-admin-item">
              <%= attachment_thumb(gallery_image,
                                  variant_options: { resize_to_fill: [200, 200] },
                                  class: "img-thumbnail w-100 gallery-admin-thumb",
                                  style: "aspect-ratio: 1 / 1; object-fit: cover;") %>
              <%= check_box_tag "product[remove_image_attachment_ids][]", gallery_image.id, false, id: checkbox_id, class: "gallery-remove-input" %>
              <%= label_tag checkbox_id, "×", class: "gallery-remove-btn", title: "Supprimer cette photo" %>
            </div>
          </div>
        <% end %>
      </div>
      <small class="text-muted d-block mt-2">Survolez une photo puis cliquez sur la croix pour la supprimer.</small>
    <% end %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit "Enregistrer", class: "btn btn-primary" %>
  </div>
<% end %>
