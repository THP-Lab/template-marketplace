<% content_for :title, @product.title %>
<% content_for :meta_description,
                meta_description_from(@product.description) ||
                "Découvrir #{@product.title}, une création artisanale disponible dans notre boutique médiévale." %>
<% content_for :structured_data do %>
  <%= jsonld_tag(product_schema(@product)) %>
<% end %>


<div class="product-section">
  <div class="container py-4">
    <%= link_to "Retour", products_path, class:"btn btn-outline-primary mb-4" %>

    <div class="row g-4 align-items-start product-detail-layout">
      <div class="col-12 col-lg-5">
        <% if @product.gallery_images.any? %>
          <% carousel_id = "product-carousel-#{@product.id}" %>
          <div id="<%= carousel_id %>" class="carousel slide gallery-carousel gallery-carousel--product" data-bs-interval="false">
            <% if @product.gallery_images.size > 1 %>
              <div class="carousel-indicators">
                <% @product.gallery_images.each_with_index do |_gallery_image, index| %>
                  <button type="button"
                          data-bs-target="#<%= carousel_id %>"
                          data-bs-slide-to="<%= index %>"
                          class="<%= "active" if index.zero? %>"
                          <%= 'aria-current="true"'.html_safe if index.zero? %>
                          aria-label="Photo <%= index + 1 %>"></button>
                <% end %>
              </div>
            <% end %>

            <div class="carousel-inner rounded-3">
              <% @product.gallery_images.each_with_index do |gallery_image, index| %>
                <div class="carousel-item <%= "active" if index.zero? %>">
                  <div class="gallery-media-square">
                    <%= attachment_thumb(gallery_image,
                                        variant_options: { resize_to_limit: [1200, 1200] },
                                        alt: "#{@product.title} - photo #{index + 1}",
                                        class: "d-block w-100 h-100 gallery-media-image",
                                        loading: (index.zero? ? "eager" : "lazy"),
                                        fetchpriority: (index.zero? ? "high" : "auto")) %>
                  </div>
                </div>
              <% end %>
            </div>

            <% if @product.gallery_images.size > 1 %>
              <button class="carousel-control-prev gallery-carousel-control" type="button" data-bs-target="#<%= carousel_id %>" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Précédent</span>
              </button>
              <button class="carousel-control-next gallery-carousel-control" type="button" data-bs-target="#<%= carousel_id %>" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Suivant</span>
              </button>
            <% end %>
          </div>
        <% else %>
          <div class="text-muted">Aucune photo disponible.</div>
        <% end %>
      </div>
      
      <div class="col-12 col-lg-7">
        <% selectable_options = @product.active_product_options %>

        <div>
          <h2><%= @product.title %></h2>
        </div>

        <div class="gold">
          <p><strong><%= @product.category %></strong></p>
        </div>

        <div>
          <%= simple_format(@product.description.to_s, {}, sanitize: true) %>
        </div>

        <div>
          <strong>Stock:</strong>
          <%= @product.stock %>
        </div>

        <div>
          <h5 class="mt-2 gold"><%= number_to_currency( @product.price, unit: "€", format: "%n %u") %></h5>
        </div>

        <%= form_with url: cart_products_path, method: :post, local: true, class: "mt-3" do %>
          <%= hidden_field_tag :product_id, @product.id %>
          <%= hidden_field_tag :quantity, 1 %>

          <% selectable_options.each do |option| %>
            <div class="mb-3">
              <label class="form-label fw-semibold"><%= option.display_name %> <span class="text-danger">*</span></label>

              <% values = option.product_option_values.ordered %>
              <% if option.color? %>
                <div class="d-flex flex-wrap gap-2">
                  <% values.each do |value| %>
                    <% input_id = "product_option_#{option.id}_value_#{value.id}" %>
                    <div class="product-color-choice">
                      <%= radio_button_tag "selected_option_values[#{option.id}]",
                                           value.id,
                                           false,
                                           id: input_id,
                                           class: "product-color-choice__input",
                                           required: true %>
                      <%= label_tag input_id, class: "product-color-choice__label", title: product_option_value_label(value) do %>
                        <span class="product-color-choice__swatch" style="background-color: <%= value.hex_color %>;"></span>
                        <span class="product-color-choice__text"><%= product_option_value_label(value) %></span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <%= select_tag "selected_option_values[#{option.id}]",
                               options_for_select(values.map { |value| [product_option_value_label(value), value.id] }),
                               include_blank: "Sélectionner #{option.display_name.downcase}",
                               required: true,
                               class: "form-select" %>
              <% end %>
            </div>
          <% end %>

          <div class="d-flex flex-wrap gap-2">
            <%= button_tag "Ajouter et continuer mes achats",
                           type: "submit",
                           name: "redirect_to",
                           value: "products",
                           class: "btn btn-primary" %>
            <%= button_tag "Ajouter et aller au panier",
                           type: "submit",
                           name: "redirect_to",
                           value: "cart",
                           class: "btn btn-outline-primary" %>
          </div>
        <% end %>
      </div>

      <% if @product.show_product_highlights? %>
        <div class="row g-4 text-center">
          <% @product.highlight_boxes.each do |box| %>
            <div class="<%= @product.highlight_column_class %>">
              <div class="card h-100 p-2">
                <h5><%= box[:title] %></h5>
                <%= simple_format(box[:description].to_s, {}, sanitize: true) %>
                <% if box[:document].present? %>
                  <div class="mt-2">
                    <%= link_to "Télécharger le document",
                                rails_blob_path(box[:document].file, disposition: "attachment"),
                                class: "btn btn-outline-primary btn-sm" %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>

<div class="container py-4">
  <div class="card  mb-4">
    <h2 class="text-center mt-4">Un besoin sur-mesure ?</h2>
    <p class="text-center mt-2">Prenez contact avec l'atelier pour réaliser vos projets personnalisés</p>

    <div class="d-flex justify-content-center mt-2 mb-3">
      <%= link_to "Contactez-nous", new_contact_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>
