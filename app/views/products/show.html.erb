<% content_for :title, @product.title %>
<% content_for :meta_description,
                meta_description_from(@product.description) ||
                "Découvrir #{@product.title}, une création artisanale disponible dans notre boutique médiévale." %>
<% content_for :structured_data do %>
  <%= jsonld_tag(product_schema(@product)) %>
<% end %>


<div class="product-section">
  <div class="container py-4">
    <%= link_to "Retour", products_path, class:"btn btn-outline-primary mb-4" %>

    <div class="row g-4 align-items-start">
      <div class="col-12 col-md-6">
        <% if @product.image.attached? %>
          <div>
            <%= attachment_thumb(@product.image,
                                variant_options: { resize_to_limit: [1200, 900] },
                                alt: @product.title,
                                class: "img img-fluid w-100",
                                loading: "eager",
                                fetchpriority: "high") %>
          </div>
        <% end %>
      </div>
      
      <div class="col-12 col-md-6">
        <div>
          <h2><%= @product.title %></h2>
        </div>

        <div class="gold">
          <p><strong><%= @product.category %></strong></p>
        </div>

        <div>
          <p><%= @product.description %></p>
        </div>

        <div>
          <strong>Stock:</strong>
          <%= @product.stock %>
        </div>

        <div>
          <h5 class="mt-2 gold"><%= number_to_currency( @product.price, unit: "€", format: "%n %u") %></h5>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <%= button_to "Ajouter et continuer mes achats",
                        cart_products_path(product_id: @product.id, quantity: 1, redirect_to: "products"),
                        method: :post,
                        class: "btn btn-primary" %>
          <%= button_to "Ajouter et aller au panier",
                        cart_products_path(product_id: @product.id, quantity: 1, redirect_to: "cart"),
                        method: :post,
                        class: "btn btn-outline-primary" %>
        </div>
      </div>

      <% if @product.show_product_highlights? %>
        <div class="row g-4 text-center">
          <% @product.highlight_boxes.each do |box| %>
            <div class="<%= @product.highlight_column_class %>">
              <div class="card h-100 p-2">
                <h5><i class="bi <%= box[:icon] %>"></i> <%= box[:title] %></h5>
                <p><%= box[:description] %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>

<div class="container py-4">
  <div class="card  mb-4">
    <h2 class="text-center mt-4">Un besoin sur-mesure ?</h2>
    <p class="text-center mt-2">Prenez contact avec l'atelier pour réaliser vos projets personnalisés</p>

    <div class="d-flex justify-content-center mt-2 mb-3">
      <%= link_to "Contactez-nous", new_contact_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>
