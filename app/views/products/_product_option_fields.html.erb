<% option_kind = form.object.option_kind.presence || ProductOption::OPTION_KIND_CUSTOM %>

<div class="product-option-config border rounded p-3 mb-3" data-product-options-form-item>
  <%= form.hidden_field :id if form.object.persisted? %>
  <%= form.hidden_field :_destroy,
                        value: (form.object.marked_for_destruction? ? "1" : "0"),
                        data: { role: "option-destroy" } %>

  <div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="h6 mb-0">Option produit</h4>
    <button type="button"
            class="btn btn-outline-danger btn-sm"
            data-action="product-options-form#removeOption">
      Supprimer l'option
    </button>
  </div>

  <div class="row g-2">
    <div class="col-12 col-md-4">
      <%= form.label :option_kind, "Type", class: "form-label" %>
      <%= form.select :option_kind,
                      options_for_select(ProductOption::KIND_OPTIONS_FOR_SELECT, option_kind),
                      {},
                      class: "form-select",
                      data: { role: "option-kind", action: "change->product-options-form#optionKindChanged" } %>
    </div>

    <div class="col-12 col-md-8">
      <%= form.label :name, "Nom de l'option", class: "form-label" %>
      <%= form.text_field :name,
                          class: "form-control",
                          placeholder: "Ex: Taille, Couleur, Finition",
                          data: { role: "option-name" } %>
    </div>
  </div>

  <div class="mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <p class="mb-0 fw-semibold">Choix disponibles</p>
      <button type="button" class="btn btn-outline-primary btn-sm" data-action="product-options-form#addValue">
        Ajouter un choix
      </button>
    </div>

    <div data-role="values-list">
      <%= form.fields_for :product_option_values do |value_fields| %>
        <%= render "products/product_option_value_fields", form: value_fields, option_kind: option_kind %>
      <% end %>
    </div>

    <template data-role="value-template">
      <%= form.fields_for :product_option_values, ProductOptionValue.new, child_index: "NEW_VALUE" do |value_fields| %>
        <%= render "products/product_option_value_fields", form: value_fields, option_kind: option_kind %>
      <% end %>
    </template>
  </div>
</div>
