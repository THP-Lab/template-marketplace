<% if params[:success] %>
  <p>Paiement réussi ! </p>
<% elsif params[:canceled] %>
  <p>Paiement annulé.</p>
<% end %>

<% content_for :title, "Boutique" %>
<% if @selected_category.present? %>
  <% content_for :meta_description, "Créations #{@selected_category.to_s.titleize} : armures, bijoux et accessoires artisanaux en vente." %>
<% else %>
  <% content_for :meta_description, "Boutique médiévale : armures, bijoux, accessoires et vêtements forgés ou cousus à la main." %>
<% end %>
<% content_for :structured_data do %>
  <% listed_products = @products.respond_to?(:limit) ? @products.first(20) : Array(@products).first(20) %>
  <%= jsonld_tag(item_list_schema(listed_products,
                                  type: "Product",
                                  name: "Catalogue produits",
                                  url_proc: ->(product) { product_url(product) })) %>
<% end %>

<div class="container py-4 mt-4">
  <h1 class="text-center mb-2"><%= @company_information.shop_page_title_or_default %></h1>
  <p class="text-center mb-4"><%= @company_information.shop_page_subtitle_or_default %></p>

  <div class="mb-4">
    <div class="d-flex flex-wrap justify-content-center gap-2">

      <%= link_to "Tous",
          products_path,
          class: "btn #{ @selected_category.blank? ? 'btn-primary' : 'btn-outline-primary' }" %>

      <% @categories.each do |category| %>
        <%= link_to category.to_s.titleize,
            products_path(category: category),
            class: "btn #{ @selected_category == category ? 'btn-primary' : 'btn-outline-primary' }" %>
      <% end %>

    </div>
  </div>

  <div id="products" class="row g-4">
    <% @products.each do |product| %>
      <div class="col-12 col-md-4">
        <%= link_to product_path(product), class: "product-card-link text-reset text-decoration-none d-block h-100" do %>
          <div class="card h-100 mb-2 product-card-clickable">
            <%= render product %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="mt-5">
    <div class="card mt-5">
      <h2 class="text-center mt-4">Un besoin sur-mesure ?</h2>
      <p class="text-center mt-2">Prenez contact avec l'atelier pour réaliser vos projets personnalisés</p>

      <div class="d-flex justify-content-center mt-2 mb-3">
        <%= link_to "Contactez-nous", new_contact_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>

  <!-- <%= link_to "New product", new_product_path, class: "btn btn-primary mt-4" %> -->

</div>
