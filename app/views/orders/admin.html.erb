<% content_for :title, "Admin - Commandes" %>

<div class="container py-4">
  <div class="row g-4">
    <div class="col-lg-4 col-xl-3">
      <%= render_admin_sidebar %>
    </div>
    <div class="col-lg-8 col-xl-9">
      <h1 class="mb-4">Commandes (administration)</h1>

      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-warning"><%= alert %></div>
      <% end %>

      <% selected_period = @filters&.dig("period").presence || "all" %>
      <% selected_sort = @filters&.dig("sort").presence || "date_desc" %>
      <% selected_status = @filters&.dig("status").presence %>
      <% selected_user_query = @filters&.dig("user_query").to_s %>
      <% filters_active = selected_user_query.present? || selected_status.present? || selected_period != "all" || selected_sort != "date_desc" %>

      <div class="card shadow-sm mb-3">
        <div class="card-body">
          <%= form_with url: admin_orders_path, method: :get, local: true, class: "row g-2 align-items-end" do %>
            <div class="col-md-3">
              <%= label_tag :user_query, "Utilisateur", class: "form-label" %>
              <%= text_field_tag :user_query, selected_user_query, class: "form-control", placeholder: "Nom, prénom ou email" %>
            </div>
            <div class="col-md-2">
              <%= label_tag :status, "Statut", class: "form-label" %>
              <%= select_tag :status,
                             options_for_select([["Tous", ""]] + order_status_options, selected_status),
                             class: "form-select" %>
            </div>
            <div class="col-md-2">
              <%= label_tag :period, "Date", class: "form-label" %>
              <%= select_tag :period,
                             options_for_select([
                               ["Toutes", "all"],
                               ["Aujourd'hui", "today"],
                               ["7 derniers jours", "7d"],
                               ["30 derniers jours", "30d"],
                               ["Année en cours", "year"]
                             ], selected_period),
                             class: "form-select" %>
            </div>
            <div class="col-md-3">
              <%= label_tag :sort, "Trier par", class: "form-label" %>
              <%= select_tag :sort,
                             options_for_select([
                               ["Date (plus récente)", "date_desc"],
                               ["Date (plus ancienne)", "date_asc"],
                               ["Utilisateur (A → Z)", "user_asc"],
                               ["Utilisateur (Z → A)", "user_desc"],
                               ["Statut (ordre métier)", "status_asc"],
                               ["Statut (ordre inversé)", "status_desc"]
                             ], selected_sort),
                             class: "form-select" %>
            </div>
            <div class="col-md-2 d-flex gap-2">
              <%= submit_tag "Filtrer", class: "btn btn-primary" %>
              <% if filters_active %>
                <%= link_to "Réinitialiser", admin_orders_path, class: "btn btn-outline-secondary" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <% if @orders.any? %>
        <% redirect_params = request.query_parameters.to_h.merge("page" => (@pagination&.dig(:page) || params[:page])) %>
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle">
            <thead>
              <tr>
                <th>Utilisateur</th>
                <th>Date</th>
                <th>Produits</th>
                <th class="text-end">Montant</th>
                <th>Statut / Suivi</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <% @orders.each do |order| %>
              <tbody data-controller="toggle-details">
                <tr id="<%= dom_id(order) %>">
                  <td><%= order.user.present? ? mask_email(order.user.email) : "—" %></td>
                  <td><%= order.order_date.present? ? l(order.order_date, format: "%d/%m/%Y") : "—" %></td>
                  <td>
                    <% if order.order_products.any? %>
                      <ul class="list-unstyled mb-0 small">
                        <% order.order_products.each do |order_product| %>
                          <% product_name = order_product.product&.title || "Produit ##{order_product.product_id}" %>
                          <li>
                            <strong><%= order_product.quantity %>x</strong> <%= product_name %>
                            <% if order_product.selected_options_label.present? %>
                              <div class="text-muted"><%= order_product.selected_options_label %></div>
                            <% end %>
                          </li>
                        <% end %>
                      </ul>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <%= number_to_currency(order.total_amount_value, unit: "€") %>
                    <div class="small text-muted">
                      Port : <%= number_to_currency(order.shipping_amount_value, unit: "€") %>
                    </div>
                    <div class="small text-muted">
                      TVA : <%= number_to_currency(order.tax_amount_value, unit: "€") %>
                    </div>
                  </td>
                  <td>
                    <%= form_with(model: order,
                                  url: order_path(order),
                                  method: :patch,
                                  data: { controller: "auto-submit" },
                                  html: { class: "d-flex flex-column gap-2" }) do |f| %>
                      <%= hidden_field_tag :redirect_to, admin_orders_path(redirect_params) %>
                      <%= f.select :status,
                                   options_for_select(order_status_options, order.status),
                                   {},
                                   class: "form-select form-select-sm",
                                   data: { action: "change->auto-submit#handle" } %>
                      <div class="d-flex align-items-center gap-2">
                        <%= f.text_field :tracking_number,
                                         value: order.tracking_number,
                                         class: "form-control form-control-sm",
                                         placeholder: "Numéro de suivi" %>
                        <button type="submit"
                                class="btn btn-outline-secondary btn-sm"
                                title="Sauvegarder le numéro de suivi"
                                aria-label="Sauvegarder le numéro de suivi">
                          <i class="bi bi-floppy"></i>
                        </button>
                        <% if order.tracking_number.present? %>
                          <span class="text-muted small">Envoyé dans l'email</span>
                        <% end %>
                      </div>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm" role="group">
                      <%= link_to invoice_order_path(order),
                                  class: "btn btn-outline-secondary",
                                  title: "Télécharger la facture PDF",
                                  aria: { label: "Télécharger la facture PDF" },
                                  data: { turbo: false } do %>
                        <i class="bi bi-download"></i>
                      <% end %>
                      <button class="btn btn-outline-secondary" data-action="toggle-details#toggle" type="button" title="Voir les informations utilisateur">👁️</button>
                    </div>
                  </td>
                </tr>
                <tr class="d-none" data-toggle-details-target="details">
                  <td colspan="6">
                    <% shipping = order.shipping_snapshot %>
                    <div class="small text-muted">
                      Email commande : <%= shipping[:email].presence || "—" %> |
                      Destinataire : <%= order.shipping_recipient_name.presence || "—" %> |
                      Téléphone : <%= shipping[:phone].presence || "—" %>
                    </div>
                    <div class="small text-muted">
                      Adresse : <%= shipping[:address].presence || "—" %>
                      <% if order.shipping_location_line.present? %>
                        , <%= order.shipping_location_line %>
                      <% end %>
                    </div>
                    <div class="small text-muted">
                      Compte client :
                      <% if order.user.present? %>
                        ID <%= order.user.id %> · <%= order.user.email %>
                      <% else %>
                        Utilisateur introuvable
                      <% end %>
                    </div>
                  </td>
                </tr>
              </tbody>
            <% end %>
          </table>
        </div>
      <% else %>
        <p class="text-muted">Aucune commande.</p>
      <% end %>

      <div class="d-flex justify-content-end mt-3">
        <%= link_to "Créer une commande", new_order_path, class: "btn btn-success" %>
      </div>
      <%= admin_pagination(@pagination) %>
    </div>
  </div>
</div>
