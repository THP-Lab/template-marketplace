<div id="<%= dom_id order %>" class="card p-4">
  <div>
    <strong>User:</strong>
    <%= order.user_id %>
  </div>

  <div>
    <strong>Order date:</strong>
    <%= order.order_date.present? ? order.order_date.strftime("%d/%m/%Y") : "—" %>
  </div>

  <div>
    <strong>Total amount:</strong>
    <%= number_to_currency(order.total_amount_value, unit: "€") %>
  </div>

  <div>
    <strong>Sous-total produits HT:</strong>
    <%= number_to_currency(order.items_amount_value, unit: "€") %>
  </div>

  <div>
    <strong>Frais de port HT:</strong>
    <%= number_to_currency(order.shipping_amount_value, unit: "€") %>
  </div>

  <div>
    <strong>TVA (<%= format_percentage(order.tax_rate_value) %>):</strong>
    <%= number_to_currency(order.tax_amount_value, unit: "€") %>
  </div>

  <div>
    <strong>Poids total:</strong>
    <%= format_weight(order.shipping_weight_value) %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= order.status_label %>
  </div>

  <% shipping = order.shipping_snapshot %>
  <div>
    <strong>Destinataire:</strong>
    <%= order.shipping_recipient_name.presence || "—" %>
  </div>

  <div>
    <strong>Adresse de livraison:</strong>
    <%= shipping[:address].presence || "—" %>
    <% if order.shipping_location_line.present? %>
      , <%= order.shipping_location_line %>
    <% end %>
  </div>

  <div>
    <strong>Email / Téléphone:</strong>
    <%= shipping[:email].presence || "—" %> · <%= shipping[:phone].presence || "—" %>
  </div>

  <% if order.tracking_number.present? %>
    <div>
      <strong>Numéro de suivi:</strong>
      <%= order.tracking_number %>
    </div>
  <% end %>

  <div class="mt-2">
    <%= link_to "Télécharger la facture PDF",
                invoice_order_path(order),
                class: "btn btn-outline-secondary btn-sm",
                data: { turbo: false } %>
  </div>
</div>
