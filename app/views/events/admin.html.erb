<% content_for :title, "Admin - Événements" %>

<div class="container py-4" data-controller="quantity-modal">
  <div class="row g-4">
    <div class="col-lg-4 col-xl-3">
      <%= render_admin_sidebar %>
    </div>
    <div class="col-lg-8 col-xl-9">
      <h1 class="mb-4">Événements (administration)</h1>

      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-warning"><%= alert %></div>
      <% end %>

      <% if @events.any? %>
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle">
            <thead>
              <tr>
                <th>Image</th>
                <th>Titre</th>
                <th>Catégorie</th>
                <th>Dates</th>
                <th>Lieu</th>
                <th class="text-end" style="width: 230px;">Actions</th>
              </tr>
            </thead>
            <tbody>
            <% @events.each do |event| %>
              <tr id="<%= dom_id(event) %>">
                <td>
                  <%= attachment_thumb(event.primary_image,
                                      variant_options: { resize_to_fill: [80, 80] },
                                      class: "img-thumbnail",
                                      style: "aspect-ratio: 1 / 1; object-fit: cover;") || content_tag(:span, "—", class: "text-muted") %>
                </td>
                <td><%= event.title %></td>
                <td><%= event.category.presence || "—" %></td>
                  <td><%= event_date_range(event) %></td>
                  <td><%= event.location.presence || "—" %></td>
                  <td class="text-end">
                    <div class="d-flex justify-content-end align-items-center gap-1 flex-nowrap admin-product-actions">
                      <%= link_to "Voir", event_path(event), class: "btn btn-outline-secondary btn-sm" %>
                      <%= link_to "Modifier", edit_event_path(event), class: "btn btn-primary btn-sm" %>
                      <%= form_with(url: event_path(event), method: :delete, class: "d-inline-flex m-0") do %>
                        <%= hidden_field_tag :redirect_to, admin_events_path(page: @pagination&.dig(:page) || params[:page]) %>
                        <%= button_tag "Supprimer",
                                       type: "submit",
                                       class: "btn btn-danger btn-sm",
                                       data: {
                                         action: "click->quantity-modal#open",
                                         modal_title: "Supprimer l’événement",
                                         modal_message: "Cette action est définitive. Voulez-vous vraiment supprimer cet événement ?",
                                         modal_confirm_label: "Supprimer"
                                       } %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted">Aucun événement.</p>
      <% end %>

      <div class="d-flex justify-content-end mt-3">
        <%= link_to "Créer un événement", new_event_path, class: "btn btn-success" %>
      </div>
      <%= admin_pagination(@pagination) %>
      <%= render "shared/confirm_modal" %>
    </div>
  </div>
</div>
