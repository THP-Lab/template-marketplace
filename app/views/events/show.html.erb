<% content_for :title, @event.title %>
<% category_label = @event.category.presence || "événement" %>
<% content_for :meta_description,
                meta_description_from(@event.description) ||
                "#{@event.title} : #{category_label.downcase} animé par notre atelier#{@event.location.presence ? " à #{@event.location}" : ""}." %>
<% content_for :structured_data do %>
  <%= jsonld_tag(event_schema(@event)) %>
<% end %>

<div class="product-section">
  <div class="container py-4">
    <div>
      <%= link_to "Retour", events_path, class:"btn btn-outline-primary mb-4" %>
    </div>

    <div class="row g-4 align-items-start event-detail-layout">
      <div class="col-12 col-lg-5">
        <% if @event.gallery_images.any? %>
          <% carousel_id = "event-carousel-#{@event.id}" %>
          <div id="<%= carousel_id %>" class="carousel slide gallery-carousel gallery-carousel--event" data-bs-interval="false">
            <% if @event.gallery_images.size > 1 %>
              <div class="carousel-indicators">
                <% @event.gallery_images.each_with_index do |_gallery_image, index| %>
                  <button type="button"
                          data-bs-target="#<%= carousel_id %>"
                          data-bs-slide-to="<%= index %>"
                          class="<%= "active" if index.zero? %>"
                          <%= 'aria-current="true"'.html_safe if index.zero? %>
                          aria-label="Photo <%= index + 1 %>"></button>
                <% end %>
              </div>
            <% end %>

            <div class="carousel-inner rounded-3">
              <% @event.gallery_images.each_with_index do |gallery_image, index| %>
                <div class="carousel-item <%= "active" if index.zero? %>">
                  <div class="gallery-media-square">
                    <%= attachment_thumb(gallery_image,
                                        variant_options: { resize_to_limit: [1200, 1200] },
                                        alt: "#{@event.title} - photo #{index + 1}",
                                        class: "d-block w-100 h-100 gallery-media-image",
                                        loading: (index.zero? ? "eager" : "lazy"),
                                        fetchpriority: (index.zero? ? "high" : "auto")) %>
                  </div>
                </div>
              <% end %>
            </div>

            <% if @event.gallery_images.size > 1 %>
              <button class="carousel-control-prev gallery-carousel-control" type="button" data-bs-target="#<%= carousel_id %>" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Précédent</span>
              </button>
              <button class="carousel-control-next gallery-carousel-control" type="button" data-bs-target="#<%= carousel_id %>" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Suivant</span>
              </button>
            <% end %>
          </div>
        <% else %>
          <div class="text-muted">Aucune photo disponible.</div>
        <% end %>
      </div>

      <div id="<%= dom_id @event %>" class="col-12 col-lg-7">
        <h2><%= @event.title %></h2>
        <div>
          <p class="gold"><strong><%= @event.category %></strong></p>
        </div>
        <div>
          <i class="bi bi-calendar-event"></i>
          <%= event_date_range(@event, format: :long) %>
        </div>
        <div>
          <i class="bi bi-geo-alt"></i>
          <%= @event.location %>
        </div>
        <div class="mt-2">
          <p><%= @event.description %></p>
        </div>
      </div>
    </div>

  </div>
</div>
<div class="container py-4">
  <div class="card p-4 mt-4">
    <h2 class="text-center mb-2">Vous organisez un événement?</h2>
    <p class="text-center mb-2">Pontius est disponible pour des démonstrations, des animations ou des collaborations.</p>
    <div class="text-center mb-2">
      <% if current_user&.is_admin? %>
        <%= link_to "Créer un événement", new_event_path, class:"btn btn-primary" %>
      <% else %>
        <%= link_to "Contactez-nous", new_contact_path, class:"btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
