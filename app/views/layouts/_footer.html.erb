<% company_information = CompanyInformation.instance %>

<footer class="py-4">
  <div class="container">

    <div class="row">
      <div class="col-12 col-md-4 mb-3">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
          <%= image_tag "logo.png",
                alt: "Template Marketplace",
                width: 35,
                height: 35,
                loading: "lazy",
                decoding: "async",
                class: "me-2" %>
          <span><strong>L'haubergerie de Pontius</strong></span>
        <% end %>
        
        <p><strong><%= company_information.footer_description_or_default %></strong></p>
      </div>

      <div class="col-12 col-md-4 mb-3">
        <ul class="list-unstyled">
          <li> 
            <strong>Navigation</strong>
          </li>
          <li>
            <%= link_to "A propos", about_pages_path, class: "text-decoration-none" %>
          </li>

          <li>
            <%= link_to "CGU", terms_pages_path, class: "text-decoration-none" %>
          </li>

          <li>
            <%= link_to "Politique de confidentialité", privacy_pages_path, class: "text-decoration-none" %>
          </li>

          <li>
            <%= link_to "Contact", new_contact_path, class: "text-decoration-none" %>
          </li>
        </ul>
      </div>

      <div class="col-12 col-md-4 mb-3">
        <ul class="list-unstyled">
          <li> 
            <strong>Contact</strong>
          </li>

          <li> 
            <%= mail_to "haubergeriedepontius@gmail.com" %>
          </li>
        </ul>

        <div class="mt-3">
          <%= link_to "Contributeurs développeurs",
                      "https://github.com/THP-Lab/template-marketplace/graphs/contributors",
                      class: "btn btn-outline-secondary btn-sm",
                      target: "_blank",
                      rel: "noopener noreferrer" %>
        </div>
      </div>
    </div>
    <div class="text-center">
      <hr>
      <p class="mb-0"><strong>© 2025 L'Haubergerie de Pontius.</strong></p>
      <p class="mb-0"><strong>Tous droits réservés.</strong></p>
    </div>
  </div>
</footer>
