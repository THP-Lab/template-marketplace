<% content_for :title, "Admin - À propos" %>

<div class="container py-4" data-controller="quantity-modal">
  <div class="row g-4">
    <div class="col-lg-4 col-xl-3">
      <%= render_admin_sidebar %>
    </div>
    <div class="col-lg-8 col-xl-9">
      <h1 class="mb-4">Page À propos (administration)</h1>

      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-warning"><%= alert %></div>
      <% end %>

      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <h2 class="h5 mb-3">Titres et descriptions des parties</h2>
          <%= form_with model: @company_information,
                        url: update_settings_about_pages_path,
                        method: :patch,
                        local: true do |f| %>
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <%= f.label :about_primary_title, "Titre section principale", class: "form-label" %>
                <%= f.text_field :about_primary_title,
                                 class: "form-control",
                                 placeholder: CompanyInformation::DEFAULT_ABOUT_PRIMARY_TITLE %>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :about_secondary_title, "Titre section secondaire", class: "form-label" %>
                <%= f.text_field :about_secondary_title,
                                 class: "form-control",
                                 placeholder: CompanyInformation::DEFAULT_ABOUT_SECONDARY_TITLE %>
              </div>
              <div class="col-12">
                <%= f.label :about_journey_title, "Titre section parcours", class: "form-label" %>
                <%= f.text_field :about_journey_title,
                                 class: "form-control",
                                 placeholder: CompanyInformation::DEFAULT_ABOUT_JOURNEY_TITLE %>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :about_primary_description, "Description section principale", class: "form-label" %>
                <%= f.text_area :about_primary_description, class: "form-control", rows: 3 %>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :about_secondary_description, "Description section secondaire", class: "form-label" %>
                <%= f.text_area :about_secondary_description, class: "form-control", rows: 3 %>
              </div>
              <div class="col-12">
                <%= f.label :about_journey_description, "Description section parcours", class: "form-label" %>
                <%= f.text_area :about_journey_description, class: "form-control", rows: 3 %>
              </div>
            </div>

            <div class="mt-3 d-flex justify-content-end">
              <%= f.submit "Enregistrer les titres/descriptions", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>

      <%= render partial: "admin_section_table",
                 locals: {
                   section_key: "primary",
                   title: @company_information.about_primary_title_or_default,
                   description: @company_information.about_primary_description,
                   blocks: @about_primary_blocks
                 } %>

      <%= render partial: "admin_section_table",
                 locals: {
                   section_key: "secondary",
                   title: @company_information.about_secondary_title_or_default,
                   description: @company_information.about_secondary_description,
                   blocks: @about_secondary_blocks
                 } %>

      <%= render partial: "admin_section_table",
                 locals: {
                   section_key: "journey",
                   title: @company_information.about_journey_title_or_default,
                   description: @company_information.about_journey_description,
                   blocks: @about_journey_blocks
                 } %>

      <%= render "shared/confirm_modal" %>
    </div>
  </div>
</div>
