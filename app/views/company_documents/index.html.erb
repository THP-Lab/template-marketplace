<% content_for :title, "Admin - Documents" %>

<%= admin_page(title: "Documents PDF") do %>
  <div class="d-flex justify-content-end mb-3">
    <%= link_to "Infos entreprise", admin_company_information_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "TVA", vat_company_information_path, class: "btn btn-outline-secondary btn-sm ms-2" %>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h2 class="h5 mb-3">Ajouter un document</h2>
      <%= render "form", company_document: @company_document, submit_label: "Ajouter" %>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <h2 class="h5 mb-3">Documents enregistrés</h2>

      <% if @company_documents.any? %>
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle">
            <thead>
              <tr>
                <th>Titre</th>
                <th>Fichier</th>
                <th>Ajouté le</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @company_documents.each do |document| %>
                <tr>
                  <td><%= document.title %></td>
                  <td>
                    <% if document.file.attached? %>
                      <%= link_to document.file.filename.to_s,
                                  rails_blob_path(document.file, disposition: "attachment"),
                                  class: "btn btn-outline-primary btn-sm" %>
                    <% else %>
                      <span class="text-muted">Fichier manquant</span>
                    <% end %>
                  </td>
                  <td><%= l(document.created_at, format: :short) %></td>
                  <td class="text-end">
                    <div class="d-flex justify-content-end gap-2">
                      <%= link_to "Modifier",
                                  edit_company_information_document_path(document),
                                  class: "btn btn-primary btn-sm" %>
                      <%= button_to "Supprimer",
                                    company_information_document_path(document),
                                    method: :delete,
                                    class: "btn btn-danger btn-sm",
                                    data: { confirm: "Supprimer ce document ?" } %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted mb-0">Aucun document PDF enregistré.</p>
      <% end %>
    </div>
  </div>
<% end %>
