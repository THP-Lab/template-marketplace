<% content_for :title, "Mon profil" %>
<% content_for :meta_description, "Mettez à jour vos coordonnées, consultez vos commandes et gérez votre compte client." %>

<div class="container py-4 mt-4">
  <h1 class="text-center mb-2">Mon profil</h1>
  <p class="text-center mb-4">Une question sur mes créations ? Un projet personnalisé ? N'hésitez pas à me contacter.</p>

  <% if notice.present? %>
    <p class="notice"><%= notice %></p>
  <% end %>

  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <p><%= pluralize(@user.errors.count, "erreur") %> empêchent l'enregistrement :</p>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card p-4">
    <%= form_with model: @user, url: user_path(@user), method: :patch, local: true do |f| %>
      <div class="mt-2">
        <%= f.label :first_name, "Prénom" %>
        <%= f.text_field :first_name, required: true, class: "form-control" %>
      </div>

      <div class="mt-2">
        <%= f.label :last_name, "Nom" %>
        <%= f.text_field :last_name, required: true, class: "form-control" %>
      </div>

      <div class="mt-2">
        <%= f.label :email %>
        <%= f.email_field :email, required: true, class: "form-control" %>
      </div>

      <div class="mt-2">
        <%= f.label :address, "Adresse" %>
        <%= f.text_field :address, class: "form-control" %>
      </div>

      <div class="mt-2">
        <%= f.label :zipcode, "Code postal" %>
        <%= f.text_field :zipcode , class: "form-control"%>
      </div>

      <div class="mt-2">
        <%= f.label :city, "Ville" %>
        <%= f.text_field :city, class: "form-control" %>
      </div>

      <div class="mt-2">
        <%= f.label :country, "Pays" %>
        <%= f.text_field :country, class: "form-control" %>
      </div>

      <div class="mt-2">
        <%= f.label :phone, "Téléphone" %>
        <%= f.telephone_field :phone, class: "form-control" %>
      </div>

      <div class="d-flex justify-content-center mt-3">
        <%= f.submit "Mettre à jour mes informations", class:"btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="card p-4 mt-4">
    <h2 class="text-center mb-2">Sécurité du compte</h2>
    <p class="text-center mb-3">Vous pouvez mettre à jour votre mot de passe à tout moment.</p>
    <div class="d-flex justify-content-center">
      <%= link_to "Changer mon mot de passe", edit_user_registration_path, class: "btn btn-primary" %>
    </div>
  </div>

  <div class="card p-4 mt-4">
    <h2 class="text-center mb-2">Historique des commandes</h2>
    <% if @orders.any? %>
      <ul class="list-unstyled">
        <% @orders.each do |order| %>
          <li class="card p-4 mb-3">
            <strong>Commande nº <%= order.id %></strong>
            <hr class="my-2">
            <p class="mb-1">
              <strong>Date :</strong>
              <%= order.order_date&.strftime("%d/%m/%Y") %>
            </p>
            <p class="mb-1">
              <strong>Statut :</strong> <%= order.status %>
            </p>
            <hr class="my-2">
            <p class="mb-3">
             <strong>Montant total :</strong> <%= number_to_currency(order.total_amount_value, unit: "€") %><br>
             <strong>Frais de port :</strong> <%= number_to_currency(order.shipping_amount_value, unit: "€") %><br>
             <strong>Poids total :</strong> <%= format_weight(order.shipping_weight_value) %>
            </p>

            <%= link_to "Télécharger la facture PDF",
                  invoice_order_path(order),
                  data: { turbo: false },
                  class: "btn btn-outline-primary btn-sm" %>

          </li>
        <% end %>
      </ul>
    <% else %>
      <p>Vous n'avez pas encore passé de commande.</p>
    <% end %>
  </div>

  <div class="account-danger-zone" data-controller="quantity-modal">
    <h2 class="text-center mt-4">Supprimer mon compte</h2>
    <p class="text-center mb-2">Cette action est définitive. Vous perdrez immédiatement l'accès à votre historique de commandes.</p>

    <div class="d-flex justify-content-center mt-3 mb-4">
      <%= form_with url: user_path(@user), method: :delete, class: "d-inline m-0" do %>
        <%= button_tag "Supprimer mon compte",
                       type: "submit",
                       class: "btn btn-danger",
                       data: {
                         action: "click->quantity-modal#open",
                         modal_title: "Supprimer définitivement le compte",
                         modal_message: "Cette action est irréversible. Le compte sera supprimé et l'accès à l'historique des commandes sera perdu pour cet utilisateur. Confirmez-vous la suppression ?",
                         modal_confirm_label: "Supprimer le compte"
                       } %>
      <% end %>
    </div>
    <%= render "shared/confirm_modal" %>
    <!-- <%= link_to "Annuler", root_path %> -->

  </div>
</div>
