<% content_for :title, "Admin - Utilisateurs" %>

<div class="container py-4">
  <div class="row g-4">
    <div class="col-lg-4 col-xl-3">
      <%= render_admin_sidebar %>
    </div>
    <div class="col-lg-8 col-xl-9">
      <h1 class="mb-4">Utilisateurs</h1>

      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>

      <div class="card shadow-sm mb-3">
        <div class="card-body">
          <%= form_with url: admin_users_path, method: :get, local: true, class: "row g-2 align-items-end" do %>
            <div class="col-md-8">
              <%= label_tag :q, "Rechercher un utilisateur", class: "form-label" %>
              <%= text_field_tag :q, @query, class: "form-control", placeholder: "Nom, prénom ou email" %>
            </div>
            <div class="col-md-4 d-flex gap-2">
              <%= submit_tag "Rechercher", class: "btn btn-primary" %>
              <% if @query.present? %>
                <%= link_to "Réinitialiser", admin_users_path, class: "btn btn-outline-secondary" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <% if @users.any? %>
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle">
            <thead>
              <tr>
                <th>Email</th>
                <th>Nom</th>
                <th>Créé le</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <% @users.each do |user| %>
              <tbody data-controller="toggle-details">
                <tr>
                  <td><%= mask_email(user.email) %></td>
                  <td><%= mask_name(user.first_name, user.last_name) %></td>
                  <td><%= user.created_at&.strftime("%d/%m/%Y") %></td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm" role="group">
                      <button class="btn btn-outline-secondary" data-action="toggle-details#toggle" type="button">👁️</button>
                    </div>
                  </td>
                </tr>
                <tr class="d-none" data-toggle-details-target="details">
                  <td colspan="4">
                    <div class="small text-muted">
                      <strong>Email:</strong> <%= user.email %> |
                      <strong>Prénom:</strong> <%= user.first_name.presence || "—" %> |
                      <strong>Nom:</strong> <%= user.last_name.presence || "—" %> |
                      <strong>Adresse:</strong> <%= user.address.presence || "—" %> |
                      <strong>CP:</strong> <%= user.zipcode.presence || "—" %> |
                      <strong>Ville:</strong> <%= user.city.presence || "—" %> |
                      <strong>Pays:</strong> <%= user.country.presence || "—" %> |
                      <strong>Tél:</strong> <%= user.phone.presence || "—" %>
                    </div>
                  </td>
                </tr>
              </tbody>
            <% end %>
          </table>
          <%= admin_pagination(@pagination) %>
        </div>
      <% else %>
        <p class="text-muted">
          <%= @query.present? ? "Aucun utilisateur ne correspond à votre recherche." : "Aucun utilisateur." %>
        </p>
      <% end %>
    </div>
  </div>
</div>
