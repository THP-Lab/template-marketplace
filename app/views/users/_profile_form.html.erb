<% cart_context = local_assigns.fetch(:cart_context, false) %>
<% redirect_path = local_assigns[:redirect_path] || (cart_context ? request.fullpath : nil) %>

<%= form_with model: user,
              url: user_path(user),
              method: :patch,
              local: true,
              data: (cart_context ? { turbo: false } : {}) do |f| %>
  <div class="card shadow-sm border-0">
    <div class="card-body">
      <% if cart_context %>
        <p class="text-muted mb-4">En enregistrant ces informations, vous serez redirigé vers votre panier.</p>
      <% end %>

      <div class="mb-3">
        <%= f.label :first_name, "Prénom", class: "form-label" %>
        <%= f.text_field :first_name, required: true, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :last_name, "Nom", class: "form-label" %>
        <%= f.text_field :last_name, required: true, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, required: true, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :address, "Adresse", class: "form-label" %>
        <%= f.text_field :address, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :zipcode, "Code postal", class: "form-label" %>
        <%= f.text_field :zipcode, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :city, "Ville", class: "form-label" %>
        <%= f.text_field :city, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :country, "Pays", class: "form-label" %>
        <%= f.text_field :country, class: "form-control" %>
      </div>

      <div class="mb-4">
        <%= f.label :phone, "Téléphone", class: "form-label" %>
        <%= f.telephone_field :phone, class: "form-control" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Enregistrer mes informations", class: "btn btn-primary w-100" %>
      </div>
    </div>
  </div>
  <% if redirect_path.present? %>
    <%= hidden_field_tag :redirect_to, redirect_path %>
  <% end %>
<% end %>
